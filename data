const fs = require('fs');
const lines = ['obstime,tempr,ap,ws,wd,rh'];
for (let i = 0; i < 16; i++) {
  // genuine day-first: day 13..28, month 1 (day > 12 makes MM-DD interpretation invalid)
  const d = new Date(2012, 0, 13 + i, 1, 30, 0);
  const md = (d.getMonth() + 1).toString().padStart(2, '0');
  const dd = d.getDate().toString().padStart(2, '0');
  lines.push([dd + '-' + md + '-' + d.getFullYear() + ' 01:30:00', -30 + i, 980, 10, 90, 60].join(','));
}
const p = 'D:/projects/sih2/backend/data/observations/dayfirst_test.csv';
fs.writeFileSync(p, lines.join('\n'));
console.log(lines.slice(0, 3).join('\n'));